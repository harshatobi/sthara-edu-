{
  "name": "sthara_school_os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node site/build.mjs --app && node scripts/build-workers.mjs",
    "dev": "next dev",
    "prebuild": "node site/build.mjs --app && node scripts/build-workers.mjs",
    "build": "next build",
    "test:site": "node --test site/tests/*.test.mjs",
    "test": "npx tsx --test src/lib/tml/*.test.ts src/lib/ops/attention.test.ts src/lib/admin/heatmap.test.ts src/lib/lab/*.test.ts src/lib/teacher/*.test.ts src/lib/papers/*.test.ts src/lib/ai/*.test.ts src/lib/student/*.test.ts src/lib/import/*.test.ts src/lib/students/*.test.ts src/lib/certificates/*.test.ts src/lib/cocurricular/*.test.ts && npm run test:site",
    "start": "next start",
    "lint": "eslint",
    "check:reads": "node scripts/check-unbounded-reads.mjs",
    "check:grants": "node scripts/check-migration-grants.mjs",
    "typecheck": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "db:login": "npx -y supabase@2.117.0 login",
    "db:link": "npx -y supabase@2.117.0 link --project-ref nqwvsuyiwswnsqbyhghb",
    "db:status": "npx -y supabase@2.117.0 migration list",
    "db:push:dry": "npx -y supabase@2.117.0 db push --dry-run",
    "db:push": "npx -y supabase@2.117.0 db push",
    "vercel:login": "npx -y vercel@59 login",
    "vercel:link": "npx -y vercel@59 link"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.75.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
