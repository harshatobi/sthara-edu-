# Copy to e2e.env (gitignored) and fill in for runs against the deployed app.
# Never commit real passwords. Leave a role blank to skip its tests.

# Where to test. Unset or localhost = a local `next dev` of the app, started for you.
E2E_BASE_URL=https://www.sthara.in

# The dedicated test school. Its name must match the pattern, or nothing signs in.
E2E_SCHOOL_CODE=QATEST1
E2E_SCHOOL_NAME_PATTERN=\b(test|qa|uat|sandbox|e2e)\b
# The class the test teacher teaches (class teacher) and the test student is in, as the app shows it.
E2E_CLASS=10-A

# One account per role in the test school.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
# Optional
E2E_CASHIER_EMAIL=
E2E_CASHIER_PASSWORD=
E2E_TEACHER2_EMAIL=
E2E_TEACHER2_PASSWORD=
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

# Optional cross-school checks: any other school's code and id (nothing is read from it).
E2E_OTHER_SCHOOL_CODE=
E2E_OTHER_SCHOOL_ID=

# Journeys write records (leave, messages, applicants, homework, registers). Test school only.
E2E_ALLOW_WRITES=0
# Steps that call Gemini (cost money). None of the current journeys need it.
E2E_ALLOW_AI=0
# Sends 31 school-code lookups to prove the rate limit.
E2E_RATE_LIMITS=0
